MainTab:CreateToggle({
	Name = "Auto Collect",
	CurrentValue = false,
	Flag = "x2",
	Callback = function(v)
		b2 = v

		if b2 then
			task.spawn(function()
				while b2 do
					for _, obj in ipairs(CollectiblesFolder:GetChildren()) do
						pcall(function()
							local char = LocalPlayer.Character
							local hrp = char and char:FindFirstChild("HumanoidRootPart")

							if hrp and obj:IsA("Instance") then
								local cf

								pcall(function()
									cf = obj:GetPivot()
								end)

								if cf then
									hrp.CFrame = cf + Vector3.new(0,3,0)
								end
							end
						end)
					end

					task.wait(0.05)
				end
			end)
		end
	end
})

