local function BuyLoop(tabName, upgradeName, stateName, boolValue)
	return function(v)
		_G[stateName] = v

		if _G[stateName] then
			Loop(function()
				return _G[stateName]
			end, function()
				a3:FireServer(tabName, upgradeName, boolValue)
			end)
		end
	end
end

