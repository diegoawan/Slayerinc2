local Cache = {}

a5.ChildRemoved:Connect(function(v)
	Cache[v.Name] = nil
end)

local function Loop(cond, func, delay)
	task.spawn(function()
		while cond() do
			pcall(func)
			task.wait(delay or 0.1)
		end
	end)
end

MainTab:CreateToggle({
	Name = "Auto Class",
	CurrentValue = false,
	Flag = "x1",
	Callback = function(v)
		b1 = v

		if b1 then
			Loop(function()
				return b1
			end, function()
				a1:FireServer("ClassUp")
			end)
		end
	end
})

MainTab:CreateToggle({
	Name = "Auto Collect",
	CurrentValue = false,
	Flag = "x2",
	Callback = function(v)
		b2 = v

		if b2 then
			task.spawn(function()
				while b2 do
					for _, obj in ipairs(a5:GetChildren()) do
						if not Cache[obj.Name] then
							Cache[obj.Name] = true

							pcall(function()
								a2:FireServer(obj.Name)
							end)
						end
					end

					task.wait(0.05)
				end
			end)
		end
	end
})

