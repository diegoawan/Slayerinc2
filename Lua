local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ResetRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Reset")
local CollectRemote = ReplicatedStorage:WaitForChild("CollectionRemotes"):WaitForChild("CollectItem")
local BuyUpgradeRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("BuyUpgrade")
local DamageRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("DamageNpc")
local OpenRuneRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("OpenRune")

local Collectibles = Workspace:WaitForChild("ClientCollectibles")

local MainTab = Window:CreateTab("Main", 4483362458)
local UpgradeTab = Window:CreateTab("Upgrades", 4483362458)
local RuneTab = Window:CreateTab("Runes", 4483362458)

local AutoClass = false
local AutoCollect = false
local AutoDamage = false

local AutoPower = false
local AutoSpawnSpeed = false
local AutoSpawnCap = false

local AutoEssencePower = false
local AutoEssenceGain = false
local AutoEssenceXP = false
local AutoEssenceMagma = false

local AutoMagmaGain = false
local AutoMagmaSpeed = false
local AutoMagmaXP = false
local AutoMagmaPower = false

local AutoStarterRune = false
local AutoGoldenRune = false

local CollectedItems = {}

Collectibles.ChildRemoved:Connect(function(child)
	CollectedItems[child.Name] = nil
end)

MainTab:CreateToggle({
	Name = "Auto Class",
	CurrentValue = false,
	Flag = "AutoClass",
	Callback = function(Value)
		AutoClass = Value

		if AutoClass then
			task.spawn(function()
				while AutoClass do
					pcall(function()
						ResetRemote:FireServer("ClassUp")
					end)

					task.wait(0.1)
				end
			end)
		end
	end
})

MainTab:CreateToggle({
	Name = "Auto Collect",
	CurrentValue = false,
	Flag = "AutoCollect",
	Callback = function(Value)
		AutoCollect = Value

		if AutoCollect then
			task.spawn(function()
				while AutoCollect do
					for _, v in ipairs(Collectibles:GetChildren()) do
						if not CollectedItems[v.Name] then
							CollectedItems[v.Name] = true

							pcall(function()
								CollectRemote:FireServer(v.Name)
							end)
						end
					end

					task.wait(0.05)
				end
			end)
		end
	end
})

