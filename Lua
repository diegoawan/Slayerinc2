local function Loop(cond, func, delay)
	task.spawn(function()
		while cond() do
			pcall(func)
			task.wait(delay or 0.1)
		end
	end)
end

local getNil = function(name, class)
	for _, v in next, getnilinstances() do
		if v.ClassName == class and v.Name == name then
			return v
		end
	end
end

